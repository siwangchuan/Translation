# Aliyun API Key for translation service
ALIYUN_API_KEY=your-aliyun-api-key-here

# CORS allowed origins (comma-separated)
# For development, you can use: http://localhost:3000,http://localhost:8080
# For production, specify your frontend domain: https://yoursite.github.io
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Optional: Backend URL for frontend (when deployed separately)
# BACKEND_URL=https://your-backend-url.com
